keybind = global:ctrl+grave_accent=toggle_quick_terminal

font-family = "Misc Fixed 6x13"
# font-family = "ProFontX"
font-size = 12

# font-family = "tewi"
# font-size = 11

font-style-italic = false
font-style-bold = false
font-style-bold-italic = false
font-feature = -calt
font-feature = -liga
font-feature = -dlig

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

# Colors follow macOS appearance: Light mode loads themes/bdb_torte_light,
# Dark mode loads themes/bdb_torte_dark (the torte palette). Ghostty swaps
# every open window when the system flips, and Neovim follows along by
# noticing the background change (see nvim/colors/bdb_torte.lua).
#
# Don't set colors (foreground, background, palette, cursor-color) directly
# in this file: anything set here overrides *both* themes.
theme = light:bdb_torte_light,dark:bdb_torte_dark
