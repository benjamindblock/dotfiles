#!/bin/bash
# Send current git repo source code to a listening machine

set -e

PORT=9999

# Display a spinner while a background process runs
spinner() {
    local pid=$1
    local chars='|/-\'
    local i=0
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r  %c " "${chars:$i:1}"
        i=$(( (i + 1) % 4 ))
        sleep 0.1
    done
    printf "\r    \r"
}

# Check if we're in a git repository
if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "Error: Not in a git repository" >&2
    exit 1
fi

# Check for target IP argument
if [ -z "$1" ]; then
    echo "Usage: repos <target-ip>" >&2
    exit 1
fi

TARGET_IP="$1"
REPO_NAME=$(basename "$(git rev-parse --show-toplevel)")

# Check if Tailscale is connected and disconnect if so
TAILSCALE_WAS_CONNECTED=false
if command -v tailscale >/dev/null 2>&1 && tailscale status >/dev/null 2>&1; then
    TAILSCALE_WAS_CONNECTED=true
    echo "Disconnecting from Tailscale..."
    tailscale down
    if tailscale status >/dev/null 2>&1; then
        echo "Error: Failed to disconnect from Tailscale" >&2
        exit 1
    fi
fi

echo "Sending $REPO_NAME to $TARGET_IP:$PORT..."

git archive --format=tar.gz HEAD | nc "$TARGET_IP" "$PORT" &
spinner $!
wait $!

# Reconnect to Tailscale if it was connected before
if [ "$TAILSCALE_WAS_CONNECTED" = true ]; then
    echo "Reconnecting to Tailscale..."
    tailscale up
    if ! tailscale status >/dev/null 2>&1; then
        echo "Error: Failed to reconnect to Tailscale" >&2
        exit 1
    fi
fi

echo "Done."
