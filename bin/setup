#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Output helpers
# ==============================================================================

step() { printf "\n\033[1m  ──▶  %s\033[0m\n" "$*"; }
ok()   { printf "  \033[32m✓\033[0m  %s\n" "$*"; }
err()  { printf "  \033[31m✗\033[0m  %s\n" "$*" >&2; exit 1; }

# ==============================================================================
# Homebrew
# ==============================================================================

step "Homebrew"
if ! command -v /opt/homebrew/bin/brew &>/dev/null; then
    echo "    Installing..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"
ok "Ready"

# ==============================================================================
# Brewfile
# ==============================================================================

step "Homebrew packages"
brew bundle --file="$HOME/.config/Brewfile" --no-upgrade
ok "Installed"

# ==============================================================================
# Fish Shell
# ==============================================================================

step "Fish shell"
FISH_PATH="/opt/homebrew/bin/fish"

if ! grep -qx "$FISH_PATH" /etc/shells; then
    echo "    Adding Fish to /etc/shells (requires sudo)..."
    echo "$FISH_PATH" | sudo tee -a /etc/shells
fi

if [ "$SHELL" != "$FISH_PATH" ]; then
    echo "    Setting Fish as default shell..."
    chsh -s "$FISH_PATH"
fi
ok "Configured"

# ==============================================================================
# vim-plug
# ==============================================================================

step "vim-plug"
VIMPLUG_VIM="$HOME/.vim/autoload/plug.vim"
if [ ! -f "$VIMPLUG_VIM" ]; then
    curl -fLo "$VIMPLUG_VIM" --create-dirs \
        https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
fi

# Install for Neovim (different autoload path).
VIMPLUG_NVIM="$HOME/.local/share/nvim/site/autoload/plug.vim"
if [ ! -f "$VIMPLUG_NVIM" ]; then
    curl -fLo "$VIMPLUG_NVIM" --create-dirs \
        https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
fi
ok "Installed"

# ==============================================================================
# Neovim Plugins
# ==============================================================================

step "Neovim plugins"
nvim --headless +PlugInstall +qa || true
ok "Installed"

# ==============================================================================
# macOS Defaults
# ==============================================================================

step "macOS defaults"
"$HOME/bin/osx"
ok "Applied"

# ==============================================================================
# mise (Language Runtimes)
# ==============================================================================

step "Language runtimes (mise)"
if command -v mise &>/dev/null; then
    mise install --yes
    ok "Installed"
else
    ok "Skipped (mise not found)"
fi

# ==============================================================================
# Work directory
# ==============================================================================

step "Work directory"
WORK_GITCONFIG="$HOME/Work/.gitconfig"
WORK_TEMPLATE="$HOME/Work/.gitconfig.template"
if [ ! -f "$WORK_GITCONFIG" ]; then
    if [ ! -f "$WORK_TEMPLATE" ]; then
        err "Work/.gitconfig.template not found — is the dotfiles repo fully checked out?"
    fi
    cp "$WORK_TEMPLATE" "$WORK_GITCONFIG"
    printf "\n"
    printf "    ┌───────────────────────────────────────────────────────┐\n"
    printf "    │  ACTION REQUIRED: Edit ~/Work/.gitconfig and set     │\n"
    printf "    │  your work name and email before cloning any work    │\n"
    printf "    │  repositories.                                        │\n"
    printf "    └───────────────────────────────────────────────────────┘\n"
    printf "\n"
fi
ok "Ready"

printf "\n"
ok "Setup complete. Quit and relaunch your terminal to start using Fish."
